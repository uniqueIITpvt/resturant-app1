/coverage
/.nyc_output
/cypress/videos
/cypress/screenshots

# next.js
/**/.next/
/out/

# build outputs
/build
/dist
/**/build
/**/dist

# misc
.DS_Store
*.pem
Thumbs.db
.cache/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

